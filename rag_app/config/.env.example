# 复制为 .env 后按本机环境修改
PROJECT_NAME=工程项目RAG智能问答系统
PROJECT_VERSION=1.0.0

VECTOR_STORE_TYPE=chroma
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
CHUNK_SIZE=512
CHUNK_OVERLAP=50
SEARCH_TOP_K=5
USE_RERANKER=false

# 本地 Ollama
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=qwen2.5:0.5b

# 可选：云端 OpenAI 兼容服务
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini

# DeepSeek：OpenAI 兼容接口
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-flash

# SiliconFlow：OpenAI 兼容接口
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL_NAME=deepseek-ai/DeepSeek-V3

# 阿里云百炼：北京共享域名；生产环境可替换为 Workspace 专属域名
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL_NAME=qwen-plus

# 智谱 AI（GLM）
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL_NAME=glm-4-flash

# Moonshot / Kimi（中国大陆平台）
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL_NAME=moonshot-v1-8k

# MiniMax（中国大陆区域）
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL_NAME=MiniMax-M3

# 腾讯混元 OpenAI 兼容接口
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
HUNYUAN_MODEL_NAME=hunyuan-turbos-latest

# 自定义 OpenAI 兼容网关（可接企业内网或其他国内平台）
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL_NAME=

API_HOST=localhost
API_PORT=8000
STREAMLIT_PORT=8501
LOG_LEVEL=INFO
